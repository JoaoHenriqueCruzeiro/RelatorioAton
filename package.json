{
  "name": "Aton-Relatorio-de-Produtos",
  "private": true,
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"electron .\"",
    "electron": "electron .",
    "build": "vite build",
    "lint": "eslint .",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "start:server": "node server.js",
    "start:dev": "concurrently \"npm run start:server\" \"npm run dev\" \"npm run electron\""
  },
  "build": {
    "appId": "com.ambarx.relatorioprodutos",
    "productName": "Aton-Relatorio-de-Produtos",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "src/backend/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/aton.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/aton.ico",
      "uninstallerIcon": "build/aton.ico",
      "installerHeaderIcon": "build/aton.ico"
    }
  },
  "dependencies": {
    "@adobe/react-spectrum": "^3.47.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/x-tree-view": "^9.1.0",
    "chart.js": "^4.5.1",
    "lucide-react": "^1.16.0",
    "mssql": "^12.5.4",
    "react": "^18.3.1",
    "react-aria-components": "^1.17.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10",
    "wait-on": "^9.0.5"
  }
}
